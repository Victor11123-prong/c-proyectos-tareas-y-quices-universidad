#include <iostream>
using namespace std;

class Vehiculo {
private:
    string marca;
    string modelo;
    int año;
    double velocidadMaxima;

public:

    // constructor
    Vehiculo(string m, string mod, int a, double vel) {
        marca = m;
        modelo = mod;

        if (a > 1886) {
            año = a;
        } else {
            año = 1887; // valor por defecto
        }

        if (vel > 0) {
            velocidadMaxima = vel;
        } else {
            velocidadMaxima = 1;
        }
    }

    // getters
    string getMarca() { return marca; }
    string getModelo() { return modelo; }
    int getAño() { return año; }
    double getVelocidadMaxima() { return velocidadMaxima; }

    // setters
    void setMarca(string m) { marca = m; }
    void setModelo(string mod) { modelo = mod; }

    void setAño(int a) {
        if (a > 1886) {
            año = a;
        }
    }

    void setVelocidadMaxima(double vel) {
        if (vel > 0) {
            velocidadMaxima = vel;
        }
    }

    // metodo mostrar info
    void mostrarInfo() {
        cout << "Marca: " << marca << endl;
        cout << "Modelo: " << modelo << endl;
        cout << "Año: " << año << endl;
        cout << "Velocidad Maxima: " << velocidadMaxima << " km/h" << endl;
        cout << "------------------------" << endl;
    }

    // metodo acelerar
    void acelerar(double incremento) {
        if (incremento > 0) {
            velocidadMaxima += incremento;
        }
    }
};

int main() {

    // probando la clase
    Vehiculo auto1("Toyota", "Corolla", 2023, 180);
    auto1.mostrarInfo();

    auto1.acelerar(20);
    auto1.mostrarInfo();

    return 0;
}
