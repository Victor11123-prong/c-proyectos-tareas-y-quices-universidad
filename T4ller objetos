#include <iostream>
using namespace std;

class Producto {
private:
    string codigo;
    string nombre;
    double precio;
    int cantidad;

public:

    // constructor
    Producto(string c, string n, double p, int cant) {
        codigo = c;
        nombre = n;

        if (p >= 0) {
            precio = p;
        } else {
            precio = 0;
        }

        if (cant >= 0) {
            cantidad = cant;
        } else {
            cantidad = 0;
        }
    }

    // getters
    string getCodigo() { return codigo; }
    string getNombre() { return nombre; }
    double getPrecio() { return precio; }
    int getCantidad() { return cantidad; }

    // setters
    void setCodigo(string c) { codigo = c; }
    void setNombre(string n) { nombre = n; }

    void setPrecio(double p) {
        if (p >= 0) {
            precio = p;
        }
    }

    void setCantidad(int c) {
        if (c >= 0) {
            cantidad = c;
        }
    }

    // calcular valor total
    double calcularValorTotal() {
        return precio * cantidad;
    }

    // aplicar descuento
    void aplicarDescuento(double porcentaje) {
        if (porcentaje > 0 && porcentaje <= 100) {
            double descuento = precio * (porcentaje / 100.0);
            precio -= descuento;
        }
    }

    // mostrar info
    void mostrarInfo() {
        cout << "Codigo: " << codigo << endl;
        cout << "Nombre: " << nombre << endl;
        cout << "Precio: $" << precio << endl;
        cout << "Cantidad: " << cantidad << endl;
        cout << "------------------------" << endl;
    }
};

int main() {

    Producto laptop("001", "Laptop HP", 850.00, 5);
    laptop.mostrarInfo();

    cout << "Valor total: $" << laptop.calcularValorTotal() << endl;

    laptop.aplicarDescuento(10); // 10% descuento
    laptop.mostrarInfo();

    return 0;
}
