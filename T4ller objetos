// ==========================
// MAIN
// ==========================
int main() {

    // Estudiante
    Estudiante est("Victor Gonzalez", 20, "123456", "Ing Sistemas", 4.2, 5);

    est.mostrarInfo();

    Curso c1("SIS101", "Prog 1", 3, "Carlos");
    Curso c2("MAT201", "Matematicas 2", 4, "Laura");

    est.matricularCurso(c1);
    est.matricularCurso(c2);

    est.verCursos();

    cout << "\nPromedio actual: " << est.calcularPromedioActual() << "\n\n";


    // Profesor
    Profesor prof("Andres Perez", 40, "998877", "Programacion", 10, 120);
    prof.mostrarInfo();

    if (prof.estaDisponible(10))
        cout << "El profesor SI está disponible a las 10.\n";
    else
        cout << "No está disponible.\n";


    // Personal
    Personal p("Maria Ruiz", 35, "554433", "Secretaria", "Administracion", 1800);
    p.mostrarInfo();
    cout << "Salario mensual: " << p.calcularSalarioMensual() << "\n";

    return 0;
}
