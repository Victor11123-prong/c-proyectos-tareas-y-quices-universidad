#include <iostream>
#include <vector>
using namespace std;

// ==========================
// CLASE PERSONA (BASE)
// ==========================
class Persona {
private:
    string nombre;
    int edad;
    string cedula;

public:
    Persona(string n, int e, string c) {
        nombre = n;
        edad = e;
        cedula = c;
    }

    // getters
    string getNombre() { return nombre; }
    int getEdad() { return edad; }
    string getCedula() { return cedula; }

    // setters con validacion simple
    void setNombre(string n) { nombre = n; }
    void setEdad(int e) {
        if (e > 0) edad = e;
    }
    void setCedula(string c) { cedula = c; }

    // metodo mostrar
    virtual void mostrarInfo() {
        cout << "Nombre: " << nombre << "\n";
        cout << "Edad: " << edad << "\n";
        cout << "Cedula: " << cedula << "\n";
    }
};

// ==========================
// CLASE CURSO
// ==========================
class Curso {
private:
    string codigo;
    string nombre;
    int creditos;
    string profesor;

public:
    Curso(string c, string n, int cr, string p) {
        codigo = c;
        nombre = n;
        creditos = cr;
        profesor = p;
    }

    void mostrarCurso() {
        cout << "Curso: " << nombre << " (" << codigo << "), "
             << "Creditos: " << creditos << ", Prof: " << profesor << "\n";
    }
};


// ==========================
// CLASE ESTUDIANTE DERIVADA
// ==========================
class Estudiante : public Persona {
private:
    string carrera;
    double promedio;
    int semestre;
    vector<Curso> cursos;

public:
    Estudiante(string nom, int ed, string cc, string car, double prom, int sem)
        : Persona(nom, ed, cc) 
    {
        carrera = car;
        promedio = prom;
        semestre = sem;
    }

    // matricular curso
    void matricularCurso(Curso c) {
        cursos.push_back(c);
    }

    void verCursos() {
        cout << "\nCursos matriculados:\n";
        for (int i = 0; i < cursos.size(); i++) {
            cursos[i].mostrarCurso();
        }
    }

    double calcularPromedioActual() {
        return promedio; // promedio ya dado (simple)
    }

    void mostrarInfo() override {
        cout << "=== ESTUDIANTE ===\n";
        Persona::mostrarInfo();
        cout << "Carrera: " << carrera << "\n";
        cout << "Promedio: " << promedio << "\n";
        cout << "Semestre: " << semestre << "\n";
    }
};


// ==========================
// CLASE PROFESOR DERIVADA
// ==========================
class Profesor : public Persona {
private:
    string especialidad;
    int anios;
    int numeroEstudiantes;

public:
    Profesor(string nom, int ed, string cc, string esp, int a, int n)
        : Persona(nom, ed, cc)
    {
        especialidad = esp;
        anios = a;
        numeroEstudiantes = n;
    }

    bool estaDisponible(int hora) {
        // simple: disponible entre 8 y 16
        return (hora >= 8 && hora <= 16);
    }

    void mostrarInfo() override {
        cout << "=== PROFESOR ===\n";
        Persona::mostrarInfo();
        cout << "Especialidad: " << especialidad << "\n";
        cout << "Años exp: " << anios << "\n";
        cout << "Num estudiantes: " << numeroEstudiantes << "\n";
    }
};


// ==========================
// CLASE PERSONAL DERIVADA
// ==========================
class Personal : public Persona {
private:
    string puesto;
    string departamento;
    double salario;

public:
    Personal(string nom, int ed, string cc, string p, string dep, double s)
        : Persona(nom, ed, cc)
    {
        puesto = p;
        departamento = dep;
        salario = s;
