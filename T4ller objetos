#include <iostream>
using namespace std;

// ----- Clase base CUENTA -----
class Cuenta {
protected:
    string numeroCuenta;
    string propietario;
    double saldo;

public:
    Cuenta(string num, string prop, double s) {
        numeroCuenta = num;
        propietario = prop;
        if (s >= 0) saldo = s;
        else saldo = 0;
    }

    // getters
    string getNumeroCuenta() { return numeroCuenta; }
    string getPropietario() { return propietario; }
    double getSaldo() { return saldo; }

    // setters con validaciones simples
    void setSaldo(double s) { if (s >= 0) saldo = s; }
    void setPropietario(string p) { propietario = p; }

    // metodos virtuales
    virtual void depositar(double monto) {
        if (monto > 0) saldo += monto;
    }

    virtual void retirar(double monto) {
        if (monto > 0 && monto <= saldo) {
            saldo -= monto;
        }
    }

    virtual void mostrarInfo() {
        cout << "Cuenta: " << numeroCuenta << endl;
        cout << "Propietario: " << propietario << endl;
        cout << "Saldo: $" << saldo << endl;
    }
};

// ----- Cuenta Ahorro -----
class CuentaAhorro : public Cuenta {
private:
    double tasaInteres;

public:
    CuentaAhorro(string num, string prop, double s, double interes)
        : Cuenta(num, prop, s)
    {
        tasaInteres = interes;
    }

    void generarInteres() {
        double interes = saldo * tasaInteres;
        saldo += interes;
    }

    void depositar(double monto) override {
        if (monto > 0) saldo += monto;
    }

    void retirar(double monto) override {
        if (monto > 0 && monto <= saldo) saldo -= monto;
    }
};

// ----- Cuenta Corriente -----
class CuentaCorriente : public Cuenta {
private:
    double limiteDescubierto;

public:
    CuentaCorriente(string num, string prop, double s, double limite)
        : Cuenta(num, prop, s)
    {
        limiteDescubierto = limite;
    }

    void solicitarDescubierto(double monto) {
        if (monto <= limiteDescubierto) {
            saldo -= monto; // se permite colocar saldo negativo
        }
    }

    void depositar(double monto) override {
        if (monto > 0) saldo += monto;
    }

    void retirar(double monto) override {
        if (monto > 0) {
            if (monto <= saldo) {
                saldo -= monto;
            } else {
                double restante = monto - saldo;
                if (restante <= limiteDescubierto) {
                    saldo -= monto; // se pone en negativo
                }
            }
        }
    }
};

int main() {

    CuentaAhorro ahorros("123456", "Carlos", 5000, 0.02);
    CuentaCorriente corriente("789012", "Ana", 2000, 1000);

    ahorros.depositar(1000);
    ahorros.mostrarInfo();
    ahorros.generarInteres();
    ahorros.mostrarInfo();
    cout << "------------------------" << endl;

    corriente.retirar(2500); // usa descubierto
    corriente.mostrarInfo();

    return 0;
}
